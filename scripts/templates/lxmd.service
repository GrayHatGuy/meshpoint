[Unit]
Description=LXMF Daemon
After=rnsd.service
Requires=rnsd.service
# PartOf ties lxmd's lifecycle to rnsd's: when rnsd restarts, lxmd
# stops AND restarts with it. Without PartOf, a `systemctl restart
# rnsd` leaves lxmd alive but disconnected from the (now-different)
# rnsd instance, which manifests as silently broken messaging.
PartOf=rnsd.service

[Service]
Type=simple
# __USER__ and __EXEC__ are placeholders substituted by setup_rnsd.sh
# during install -- see the matching note in rnsd.service.
User=__USER__
Group=__USER__
# See the matching note in rnsd.service. Without this, lxmd's
# "LXMF Router ready to receive on <hash>" line is invisible to
# `journalctl -u lxmd` until the process exits, which makes the
# Meshpoint /api/reticulum/identity endpoint return null address.
Environment=PYTHONUNBUFFERED=1
ExecStart=__EXEC__

Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
